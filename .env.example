# ── متغيرات الواجهة الأمامية (تُقرأ داخل المتصفح — لا تضع أسرارًا هنا) ──
# رابط مشروع Supabase، مثال: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# مفتاح anon العام (publishable). هذا المفتاح آمن في الواجهة لأن RLS يحرس البيانات.
VITE_SUPABASE_ANON_KEY=

# اتركه فارغًا للعمل على Supabase. اجعله true لمعاينة التصميم على بيانات
# تجريبية محلية حتى لو كانت المفاتيح أعلاه مضبوطة (مفيد قبل تطبيق migrations).
VITE_DEMO_MODE=

# ────────────────────────────────────────────────────────────────────────
# الأسرار التالية تُضبط في Supabase (Edge Function secrets) وليس في هذا الملف
# ولا تُقرأ من الواجهة الأمامية أبدًا:
#
#   SUPABASE_URL              يُحقن تلقائيًا داخل الـ Edge Function
#   SUPABASE_SERVICE_ROLE_KEY يُحقن تلقائيًا داخل الـ Edge Function
#   MATCH_WEBHOOK_SECRET      سر تتحقق منه الوظيفة قبل التنفيذ
#
# اضبطها بالأمر:
#   supabase secrets set MATCH_WEBHOOK_SECRET="<قيمة عشوائية طويلة>"
# ────────────────────────────────────────────────────────────────────────
